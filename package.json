{
  "name": "digital-human-terminal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "数字人终端 — 与本地 Hermes Agent 语音对话的 Live2D 数字人",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "download-model": "tsx scripts/download-model.ts",
    "download-all": "tsx scripts/download-model.ts && tsx scripts/download-cubism-core.ts",
    "asr-service": "cd server/asr-service && python asr_service.py",
    "orchestrator": "cd server/orchestrator && node index.js",
    "voice-all": "echo '启动编排服务 + ASR...' && start cmd /c \"cd server/asr-service && python asr_service.py\" && start cmd /c \"cd server/orchestrator && node index.js\""
  },
  "dependencies": {
    "pixi-live2d-display": "0.5.0-beta",
    "pixi.js": "^7.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^42.5.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
